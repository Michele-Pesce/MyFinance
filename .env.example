# Copy to .env.local and fill in. Never commit .env.local.
# Local Supabase values come from `pnpm exec supabase status` after `pnpm exec supabase start`.

# --- Supabase ---
# Public (sent to the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used by the price job, instrument linking and account deletion. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Used by tests/rls.test.ts (same values as above)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# --- Daily price job (M2) ---
# Protects GET /api/cron/prices (Vercel Cron sends it as "Authorization: Bearer <value>"). Any long random string.
CRON_SECRET=
# Signs instrument search results so users can only link instruments the server itself returned. Any long random string.
INSTRUMENT_SIGNING_SECRET=

# Price providers. Create the free keys yourself on each site and paste them here, never in chat or in git.
# ETF / stocks, primary: https://eodhd.com  (free: 20 calls/day, end of day)
EODHD_API_KEY=
# ETF / stocks, fallback: https://www.alphavantage.co/support/#api-key  (free: 25 calls/day)
ALPHAVANTAGE_API_KEY=
# Crypto: https://www.coingecko.com/en/api  (Demo key, free). Optional: without it the public endpoint is used.
COINGECKO_API_KEY=

# Optional: override the free-plan daily call limits if you upgrade a plan.
# EODHD_DAILY_LIMIT=20
# ALPHAVANTAGE_DAILY_LIMIT=25
# COINGECKO_DAILY_LIMIT=300

# Public URL of the deployed app (used in the login email link instead of the request's Host/Origin headers).
# SITE_URL=https://your-app.example.com
